<?xml version="1.0" ?>
<ruleset name="Project-specific Coding Standards Overrides">
	<!--
		Use the WordPress.org Meta Coding Standards for the project (from wporg-repo-tools),
		but override a few specific rules in a few directories. This will let us keep using phpcs
		on those directories without flagging known non-issues from generated or forked code.
	-->

	<!-- Lint only the versioned theme; skip Composer-installed third-party code and tooling scripts so a bare `composer lint` (no path) stays scoped, like `.gitignore`. -->
	<exclude-pattern>source/wp-content/plugins/*</exclude-pattern>
	<exclude-pattern>source/wp-content/mu-plugins/*</exclude-pattern>
	<exclude-pattern>source/wp-content/themes/wporg-showcase/*</exclude-pattern>
	<exclude-pattern>source/wp-content/themes/wporg-parent-2021/*</exclude-pattern>
	<exclude-pattern>env/*</exclude-pattern>

	<!-- Import the shared PHPCS settings. -->
	<rule ref="./phpcs.xml.dist">
		<!--
			Drop PHPCompatibility. It checks the theme for compatibility with older
			PHP versions, but wordpress.org runs PHP 8.4 — the version we develop,
			lint, and ship on — so there is nothing older to support. (It also can't
			run on PHP 8.1+ in its installable form, and the fixed line needs
			PHP_CodeSniffer 4, which no released WPCS supports yet.)
		-->
		<exclude name="PHPCompatibility" />
	</rule>

	<!-- Allow unescaped content in patterns. -->
	<rule ref="WordPress.Security.EscapeOutput.UnsafePrintingFunction">
		<exclude-pattern>source/wp-content/themes/wporg-showcase-2022/patterns/*</exclude-pattern>
	</rule>

	<!-- Allow php tags to be on same line as HTML. -->
	<rule ref="Squiz.PHP.EmbeddedPhp.ContentBeforeOpen">
		<exclude-pattern>source/wp-content/themes/wporg-showcase-2022/patterns/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.PHP.EmbeddedPhp.ContentAfterEnd">
		<exclude-pattern>source/wp-content/themes/wporg-showcase-2022/patterns/*</exclude-pattern>
	</rule>

	<!-- Don't enforce file names on patterns to support partials. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>source/wp-content/themes/wporg-showcase-2022/patterns/*</exclude-pattern>
	</rule>
</ruleset>
